# Copie para .env e ajuste se necessário. Sem .env, o docker-compose usa estes mesmos valores padrão.
POSTGRES_DB=education
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Mínimo de 32 caracteres. Troque fora do ambiente de desenvolvimento.
JWT_SIGNING_KEY=dev-only-signing-key-troque-em-producao-0123456789
# Chave compartilhada entre API e Worker (header X-Internal-Api-Key).
INTERNAL_API_KEY=dev-only-internal-api-key

FRONTEND_ORIGIN=http://localhost:3000

# Serviço de mídia (Nginx). MEDIA_PUBLIC_URL é o endereço que o navegador do aluno usa para o HLS.
MEDIA_PORT=8081
MEDIA_PUBLIC_URL=http://localhost:8081
