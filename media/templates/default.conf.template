# Serviço de mídia: entrega os arquivos HLS gerados pelo Worker, direto do volume (somente leitura).
# A Education API não participa do streaming; ela só informa a URL do master.m3u8.
# Arquivo processado pelo envsubst da imagem oficial do Nginx (${FRONTEND_ORIGIN} vem do docker-compose).

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /videos;
    autoindex off;

    sendfile on;
    tcp_nopush on;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # Somente "processed/" é público. O vídeo original ("original/") nunca é exposto.
    location /processed/ {
        types {
            application/vnd.apple.mpegurl m3u8;
            video/mp2t ts;
        }
        default_type application/octet-stream;

        # Playlists: cache curto.
        location ~ \.m3u8$ {
            include /etc/nginx/conf.d/preflight.inc;
            include /etc/nginx/conf.d/cors.inc;
            add_header Cache-Control "public, max-age=60" always;
        }

        # Segmentos: cada upload gera um novo videoId, então o conteúdo de uma URL não muda.
        location ~ \.ts$ {
            include /etc/nginx/conf.d/preflight.inc;
            include /etc/nginx/conf.d/cors.inc;
            add_header Cache-Control "public, max-age=86400" always;
        }

        return 404;
    }

    location / {
        return 404;
    }
}
